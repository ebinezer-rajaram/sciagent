+    n = d.size
+    if n % 2:
+        return float(d[n // 2])
+    lo, hi = float(d[n // 2 - 1]), float(d[n // 2])
+    if math.isinf(lo) and math.isinf(hi) and lo != hi:
+        return 0.0
+    return (lo + hi) / 2.0
