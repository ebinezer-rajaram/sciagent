{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run mypy*)",
      "Bash(uv run ruff*)",
      "Bash(uv run python tests/acceptance/determinism_child.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree*)",
      "Bash(git merge-base*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.git/config)",
      "Edit(**/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.claude/settings.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(iwr*)",
      "PowerShell(Invoke-Expression*)",
      "PowerShell(iex*)",
      "PowerShell(curl*)",
      "PowerShell(wget*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item*-Recurse*-Force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.sh\"",
            "timeout": 90,
            "statusMessage": "Formatting and checking invariant 3"
          }
        ]
      }
    ]
  }
}
