+def _with_gap(
+    rows: list[ScoreRow], truth: str, seed: int, system: str, gap: float
+) -> list[ScoreRow]:
+    return [
+        ScoreRow(r.truth, r.seed, r.system, gap, None, r.exact, r.in_dictionary, None)
+        if (r.truth, r.seed, r.system) == (truth, seed, system)
+        else r
+        for r in rows
+    ]
+
