# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Derived artefacts. `.cache/tables/` holds empirical tables, which are a pure
# function of their content address and are rebuilt on demand (see
# tests/acceptance/test_a06_a11.py). They are derived, not authored.
.cache/

# Machine-local harness settings: absolute paths and per-machine permissions,
# which belong to no other checkout. Ignored here rather than relying on a
# developer's personal ~/.config/git/ignore -- that covers this machine only, so
# on any other one `git add -A` inside a worktree would stage it.
.claude/settings.local.json

# One git worktree per concurrent local session, created here by the harness.
# A worktree is a checkout of this same repository, so leaving it untracked
# would show every one of its files as untracked in the parent's `git status` --
# the exact noise the worktrees exist to remove. Ignoring it also keeps VS Code's
# search out of them (`search.useIgnoreFiles` defaults true) while leaving them
# browsable in the explorer (`explorer.excludeGitIgnore` defaults false).
.claude/worktrees/

# Working notes for harness/workflow changes. Untracked: these are plans and
# scratch analysis about how Claude Code is configured, not project artefacts.
# The record of what was decided belongs in docs/DECISIONS.md.
docs/notes/
